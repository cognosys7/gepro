	partition TProg_Reprog-ffeb66b4-caf8-49cb-987a-cf08e4891c58 = calculated
		mode: import
		source = ```
				
				var AnioMesEje = [AnioMesEjecucion]
				return SUMMARIZE( FILTER(bibd_cont_etapa_control, bibd_cont_etapa_control[Año-Mes-Valorizacion]<= AnioMesEje),  
				--return SUMMARIZE( FILTER(bibd_cont_etapa_control, bibd_cont_etapa_control[CtlTipoPlan] <> "2. EJECUCIÓN REAL" ),  
				                    bibd_contrato[ContCodigoEntidad], 
				                     "MaxPlan", MAX(bibd_cont_etapa_control[ContratoConceptoPlan2]),
				                     "MtoProg",   CALCULATE( sum(bibd_cont_etapa_control[CtlDetMontoBruto]),  bibd_trimestre[Grupo]<>"Posterior", 
				                                   FILTER(bibd_cont_etapa_control, bibd_cont_etapa_control[CtlTipoPlan] = "1. LÍNEA BASE"), bibd_contrato[GrupoMGAvanceFisico]="GrupoAF", bibd_cont_etapa_control[Año-Mes-Valorizacion] <= AnioMesEje ),
				                     "MtoReprog", CALCULATE( sum(bibd_cont_etapa_control[CtlDetMontoBruto]),  bibd_trimestre[Grupo]<>"Posterior", 
				                                   filter(bibd_cont_etapa_control, bibd_cont_etapa_control[ContratoConceptoPlan] = RELATED(TReprogMax[RepMAx])) ,                                        
				                                   bibd_cont_etapa_control[CtlTipoPlan]="3. REPROGRAMACION", bibd_contrato[GrupoMGAvanceFisico]="GrupoAF", bibd_cont_etapa_control[Año-Mes-Valorizacion] <= AnioMesEje )            
				                   ) 
				```

	annotation PBI_Id = 683831fe18c14f7a8778c50b3accd6cb

