table bibd_proy_costo_componente
	lineageTag: b15041be-8fca-4133-85e5-78251d8098ac

	measure '% AvanceFisico' =
			
			VAR R1 = CALCULATE(max(bibd_proy_costo_componente[AvanceFisico]), USERELATIONSHIP(bibd_trimestre[Anio-Trim],bibd_proy_costo_componente[AñoTrimestre] ), FILTER(
					ALLSELECTED(bibd_proy_costo_componente[AñoTrimestre]), bibd_proy_costo_componente[AñoTrimestre]  = max(bibd_proy_costo_componente[AñoTrimestre]) ) )
			VAR R2 = CALCULATE( max(bibd_proy_costo_componente[AvanceFisico])  )
			
			VAR R3 = IF(ISBLANK(R1),0,R1)
			RETURN R3
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 2da95b42-7437-425d-80b9-99be560cf7af

