	column GrupoComponente =
			SWITCH(
			  TRUE,
			  ISBLANK('bibd_proy_costo_comp_UP'[Componente]),
			  "(En blanco)",
			  'bibd_proy_costo_comp_UP'[Componente] IN {"1. Plan de Cierre"},
			  "1. PLAN DE CIERRE",
			  'bibd_proy_costo_comp_UP'[Componente] IN {"2. Perfil"},
			  "2. PERFIL",
			  'bibd_proy_costo_comp_UP'[Componente] IN {"3. Expediente Técnico"},
			  "3. EXPEDIENTE TÉCNICO",
			  'bibd_proy_costo_comp_UP'[Componente] IN {"4. Obra",
			    "5. Supervisión",
			    "6. Gestión de Proyecto",
			    "7. Capacitación"},
			  "4. EJECUCIÓN DE OBRA",
			  'bibd_proy_costo_comp_UP'[Componente] IN {"8. Post Cierre"},
			  "5. POST CIERRE",
			  'bibd_proy_costo_comp_UP'[Componente]
			)
		lineageTag: 2a62cfbc-8290-4fab-97b8-a8dae6df0051
		summarizeBy: none

