	column ProyNombrePrinc = if(ISBLANK(bibd_proyecto[ProyNombreIngles]),"-",bibd_proyecto[ProyNombreIngles] &" - "&bibd_proyecto[ProyPrincipal] )
		lineageTag: 4b4f3d70-5933-4998-aea6-4dde9123a5c8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"bibd_proyecto","TableItemName":"GrupoProyecto","ObjectType":4},"LinkType":"UsedInGroup"}]

	column GrupoProyecto =
			SWITCH(
			  TRUE,
			  ISBLANK('bibd_proyecto'[ProyNombrePrinc]),
			  "(En blanco)",
			  'bibd_proyecto'[ProyNombrePrinc] IN {"AAHH. LAS MERCEDES ALTO PERU - 0",
			    "ACOBAMBA Y COLQUI - 0",
			    "ADMINISTRATIVOS-EXTERNOS - 0",
			    "ALTO MARCAVALLE - LADERAS - 0",
			    "ALTO MARCAVALLE-REFORESTACION - 0",
			    "AREAS PUBLICAS SAN VICENTE DE PAUL - 0",
			    "AZALIA Y PUCARA-TRABAJO COMPLEMENTARIO - 0",
			    "AZALIA-DEPOSITO DE LODOS - 0",
			    "BUENOS AIRES - ESPACIO RECREATIVO - 0",
			    "CHICHAYRO - 0",
			    "CHUCCHIS 1ERA Y 2DA ZONA - 1",
			    "CLEOPATRA - 0",
			    "CLUSTER MINERO - 0",
			    "CONDORCANA 1 - 0",
			    "CONDORCANA 2 - 0",
			    "CONDORCANA 3 - 0",
			    "CONVENIO PROINVERSION INGEMMET - 0",
			    "CORPORATIVOS - 0",
			    "CURAPAMPA - 0",
			    "EL PORVENIR - 0",
			    "ESQUILACHE - 0",
			    "EX UNIDAD GOYLLARISQUIZGA - 1",
			    "EXCELSIOR-ABANDONO DESMONTE - 0",
			    "JEREZ - 0",
			    "LA OROYA - DEPOSITO DE SUELOS - 0",
			    "LADERAS OROYA ANTIGUA - 0",
			    "LOS NEGROS - 0",
			    "MAGISTRAL - 1",
			    "MANTENIMIENTO-NO ES PROYECTO-NO USAR - 0",
			    "MERCEDES ALTO PERU-PISTAS VEREDAS Y GRAD - 0",
			    "MICHIQUILLAY - MANTENIMIENTO - 1",
			    "MICHIQUILLAY- MANEJO DE AGUAS - 0",
			    "MICHIQUILLAY-MITIGACION Y REVEGETACION - 0",
			    "MICHIQUILLAY-SECTOR RELAVERA DEL PC - 0",
			    "MICHIQUILLAY-TRATAMIENTO DE POZAS - 0",
			    "MURUCATA - 0",
			    "NORMAN KING - 0",
			    "OROYA ANTIGUA - ESCALINATAS - 0",
			    "PILOTO CALIOC - 0",
			    "POR CONVENIO - 0",
			    "POYO NEGRO - 0",
			    "PUSHAQUILCA - 0",
			    "QUIULACOCHA-CARRETERA - 0",
			    "QUIULACOCHA-PLANTA DE TRATAMIENTO - 0",
			    "QUIULACOCHA-SISTEMA NEUTRALIZACION - 0",
			    "REMANENTES SANTA ROSA DE SACCO - 1",
			    "SAN JUAN Y DELTA - PLAN DE CIERRE - 0",
			    "SAN VICENTE DE PAUL-PISTAS Y VEREDAS - 0",
			    "TACARPANA - PARQUE ECOLOGICO - 0",
			    "TACARPANA Y MURUHUAY - 0",
			    "TACARPANA-REFORESTACION - 0",
			    "YERBA BUENA CHICA - 0"},
			  "-",
			  'bibd_proyecto'[ProyNombrePrinc] IN {"5 RELAVERAS - 1"},
			  "5 RELAVERAS",
			  'bibd_proyecto'[ProyNombrePrinc] IN {"64 PASIVOS - ESTUDIOS - 1"},
			  "64 PASIVOS - ESTUDIOS",
			  'bibd_proyecto'[ProyNombrePrinc] IN {"64 PASIVOS-MANTENIMIENTO - 1"},
			  "64 PASIVOS - MANTENIMIENTO",
