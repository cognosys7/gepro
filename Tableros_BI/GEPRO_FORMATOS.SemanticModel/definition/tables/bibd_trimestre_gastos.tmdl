	column GrupoTrimestre =
			SWITCH(
			  TRUE,
			  ISBLANK('bibd_trimestre_gastos'[MatchTrim]),
			  "(En blanco)",
			  'bibd_trimestre_gastos'[MatchTrim] IN {"1"},
			  "Actual",
			  'bibd_trimestre_gastos'[MatchTrim] IN {"3"},
			  "Anterior",
			  'bibd_trimestre_gastos'[MatchTrim] IN {"2"},
