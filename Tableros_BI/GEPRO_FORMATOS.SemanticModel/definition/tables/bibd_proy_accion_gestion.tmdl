	column GrupoComponente =
			SWITCH(
			  TRUE,
			  ISBLANK('bibd_proy_accion_gestion'[ComponenteTipo]),
			  "(En blanco)",
			  'bibd_proy_accion_gestion'[ComponenteTipo] IN {"PLAN DE CIERRE"},
			  "1. PLAN DE CIERRE",
			  'bibd_proy_accion_gestion'[ComponenteTipo] IN {"PERFIL"},
			  "2. PERFIL",
			  'bibd_proy_accion_gestion'[ComponenteTipo] IN {"EXPEDIENTE TECNICO"},
			  "3. EXPEDIENTE TECNICO",
			  'bibd_proy_accion_gestion'[ComponenteTipo] IN {"EJECUCIÓN DE OBRA"},
			  "4. EJECUCIÓN DE OBRA",
			  'bibd_proy_accion_gestion'[ComponenteTipo] IN {"SUPERVISION DE OBRA"},
			  "5. SUPERVISION DE OBRA",
			  'bibd_proy_accion_gestion'[ComponenteTipo] IN {"GESTION DE PROYECTO"},
			  "6. GESTION DE PROYECTO",
			  'bibd_proy_accion_gestion'[ComponenteTipo]
			)
