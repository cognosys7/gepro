table bibd_proy_accion_gestion
	lineageTag: a78c8115-8002-445a-99e0-327705d9d1af

	measure Ide = ```
			
			VAR V_TIPO = SELECTEDVALUE(TipoInforme[Tipo])
			VAR R1 = CALCULATE(max(bibd_proy_accion_gestion[AccionIde]), USERELATIONSHIP(bibd_trimestre[Anio-Trim],bibd_proy_accion_gestion[AñoTrimestre] ), FILTER(
					 ALLSELECTED(bibd_proy_accion_gestion[AccionFecha]), bibd_proy_accion_gestion[AccionFecha]  = max(bibd_proy_accion_gestion[AccionFecha]) ) )
			VAR R2 = CALCULATE(max(bibd_proy_accion_gestion[AccionIde]), USERELATIONSHIP(bibd_trimestre[Anio],bibd_proy_accion_gestion[Año] ), FILTER(
					 ALLSELECTED(bibd_proy_accion_gestion[AccionFecha]), bibd_proy_accion_gestion[AccionFecha]  = max(bibd_proy_accion_gestion[AccionFecha]) ) )
			VAR R3 = IF(V_TIPO = "Anual", R2, R1)         
			RETURN R3
			```
		formatString: 0
		lineageTag: 776dd294-0440-4413-a1e2-31cef536b439

