table bibd_proy_accion_correctiva
	lineageTag: 5b2f580b-a54c-433e-9b87-c54f7119692f

	measure IdeAccionCorrectiva = ```
			
			VAR V_TIPO = SELECTEDVALUE(TipoInforme[Tipo])
			VAR R1 = CALCULATE(max(bibd_proy_accion_correctiva[AccionIde]), USERELATIONSHIP(bibd_trimestre[Anio-Trim],bibd_proy_accion_correctiva[AñoTrimestre] ), FILTER(
					 ALLSELECTED(bibd_proy_accion_correctiva[AccionFecha]), bibd_proy_accion_correctiva[AccionFecha]  = max(bibd_proy_accion_correctiva[AccionFecha]) ) )
			VAR R2 = CALCULATE(max(bibd_proy_accion_correctiva[AccionIde]), USERELATIONSHIP(bibd_trimestre[Anio],bibd_proy_accion_correctiva[Año] ), FILTER(
					 ALLSELECTED(bibd_proy_accion_correctiva[AccionFecha]), bibd_proy_accion_correctiva[AccionFecha]  = max(bibd_proy_accion_correctiva[AccionFecha]) ) )
			VAR R3 = IF(V_TIPO = "Anual", R2, R1)         
			RETURN R3
			```
		formatString: 0
		lineageTag: eee30e21-5978-4308-9847-c0fe5e1263ac

