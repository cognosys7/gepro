table bibd_proy_oportunidad_riesgo
	lineageTag: c51ce6dd-6fd6-43b7-a107-cf1940c03bd7

	measure Valoracion = ```
			
			VAR V_TIPO = SELECTEDVALUE(TipoInforme[Tipo])
			VAR R1 = CALCULATE(sum(bibd_proy_oportunidad_riesgo[ValoracionValor]), USERELATIONSHIP(bibd_trimestre[Anio-Trim],bibd_proy_oportunidad_riesgo[AñoTrimestre] ) )
					 
			VAR R2 = CALCULATE(sum(bibd_proy_oportunidad_riesgo[ValoracionValor]), USERELATIONSHIP(bibd_trimestre[Anio],bibd_proy_oportunidad_riesgo[Año] ) )
			
			VAR R3 = IF(V_TIPO = "Anual", R2, R1)         
			RETURN R3
			
			```
		lineageTag: 2fd3c18c-8a36-4379-a8b9-f05a4a929bfe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IdeRiesgo = ```
			
			VAR V_TIPO = SELECTEDVALUE(TipoInforme[Tipo])
			VAR R1 = CALCULATE(max(bibd_proy_oportunidad_riesgo[RiesgoIde]), USERELATIONSHIP(bibd_trimestre[Anio-Trim],bibd_proy_oportunidad_riesgo[AñoTrimestre] ), FILTER(
					 ALLSELECTED(bibd_proy_oportunidad_riesgo[RiesgoFecha]), bibd_proy_oportunidad_riesgo[RiesgoFecha]  = max(bibd_proy_oportunidad_riesgo[RiesgoFecha]) ) )
			VAR R2 = CALCULATE(max(bibd_proy_oportunidad_riesgo[RiesgoIde]), USERELATIONSHIP(bibd_trimestre[Anio],bibd_proy_oportunidad_riesgo[Año] ), FILTER(
					 ALLSELECTED(bibd_proy_oportunidad_riesgo[RiesgoFecha]),  bibd_proy_oportunidad_riesgo[RiesgoFecha] = max(bibd_proy_oportunidad_riesgo[RiesgoFecha]) ) )
			VAR R3 = IF(V_TIPO = "Anual", R2, R1)         
			RETURN R3
			```
		formatString: 0
		lineageTag: 815909d3-2575-4286-88e9-2d9f0b362c8a

