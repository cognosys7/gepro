	measure 'CostoBruto(PV ini) SinCorte' = CALCULATE(sum(bibd_cont_etapa_control[CtlDetMontoBruto]), bibd_cont_etapa_control[GrupoConcepto]="1. Programado", bibd_contrato[GrupoMGAvanceFisico]="GrupoAF" )*1.18
		formatString: #,0.00
		lineageTag: 76281cc6-0066-418d-9664-52749adbc262

	measure SPI = ```
			
			var rPVIni = [CostoBruto(EV rep) Corte] / [CostoBruto(PV ini) Corte]
			var rPVRep = if([CostoBruto(PV rep) Corte] > 0, [CostoBruto(EV rep) Corte] / [CostoBruto(PV rep) Corte], 0 )
			
			var vCosto = CALCULATE(sum(bibd_cont_etapa_control[CtlDetMontoBruto]), bibd_cont_etapa_control[GrupoConcepto]="3. Real",  bibd_contrato[GrupoMGAvanceFisico]="GrupoAF" , bibd_trimestre[Grupo]<>"Posterior")
			
			var AnioMesEje = [AnioMesEjecucion]
			var vPro = IFERROR(CALCULATE( sum(bibd_cont_etapa_control[CtlDetMontoBruto]),  bibd_trimestre[Grupo]<>"Posterior", bibd_contrato[GrupoMGAvanceFisico]="GrupoAF" , bibd_cont_etapa_control[Año-Mes-Valorizacion]<= AnioMesEje,                                                                  
			                        bibd_cont_etapa_control[CtlTipoPlan]="1. LÍNEA BASE"                                              
			                 ) ,0) 
			VAR R_Pro = IFERROR(vCosto/vPro,0)
			
			var vRepro = IFERROR(CALCULATE( sum(bibd_cont_etapa_control[CtlDetMontoBruto]),  bibd_trimestre[Grupo]<>"Posterior", bibd_contrato[GrupoMGAvanceFisico]="GrupoAF" , bibd_cont_etapa_control[Año-Mes-Valorizacion]<= AnioMesEje,
			                       filter(bibd_cont_etapa_control, bibd_cont_etapa_control[ContratoConceptoPlan] = RELATED(TReprogMax[RepMAx])),                                             
			                        bibd_cont_etapa_control[CtlTipoPlan]="3. REPROGRAMACION"                                              
			                 ) ,0) 
			VAR R_Repro = IFERROR(vCosto/vRepro,0)
			VAR R2 = IF(R_Repro=0,R_Pro,R_Repro)
			return R2
			```
		lineageTag: 0ae14729-99ab-43cc-bb64-4f990d238701

		annotation PBI_FormatHint = {"isGeneralNumber":true}

