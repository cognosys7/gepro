	measure FechaCorteOk =
			
			VAR vAnioTrim = SELECTEDVALUE(bibd_trimestre[Anio-Trim])
			VAR vAnio     = mid(vAnioTrim,1,4)
			VAR vTrim     = mid(vAnioTrim,6,1)
			VAR vFechaTrim      = if(vTrim="1","31/03/",if(vTrim="2","30/06/",if(vTrim="3","30/09/","31/12/")))&vAnio
			VAR vAnioTrimAct = SELECTEDVALUE('KPI FORMATO_2'[AnioTrimestreActual])
			VAR R = if(vAnioTrim = vAnioTrimAct, SELECTEDVALUE('KPI FORMATO_2'[FechaCorte]), "Fecha Corte "&vFechaTrim)
			Return R
		lineageTag: 27302b53-7d3f-40c4-bcbe-0b91209da4eb

