	measure '% AvaFisico(PV ini)' = ```
			CALCULATE(sum(bibd_cont_etapa_control[CtlDetMontoBruto]), bibd_cont_etapa_control[GrupoConcepto]="1. Programado", bibd_trimestre[Grupo]<>"Posterior") / 
			CALCULATE( 	SUM('bibd_cont_etapa_control'[CtlDetMontoBruto]),
				       ALL('bibd_cont_etapa_control'[Año-Mes-Valorizacion]), bibd_cont_etapa_control[GrupoConcepto]="1. Programado"	
