	measure SPI-Denominador-OBRA = ```
			
			
			var AnioMesEje = [AnioMesEjecucion]
			var vReprog =  CALCULATE( sum(bibd_cont_etapa_control[CtlDetMontoBruto]),  bibd_trimestre[Grupo]<>"Posterior", bibd_cont_etapa_control[Año-Mes-Valorizacion]<= AnioMesEje,
			                                   filter(bibd_cont_etapa_control, bibd_cont_etapa_control[ContratoConceptoPlan] = RELATED(TReprogMax[RepMAx])) ,                                        
			                                   bibd_cont_etapa_control[CtlTipoPlan]="3. REPROGRAMACION", bibd_contrato[GrupoMGAvanceFisico]="GrupoAF" )
			
			
			var vProg   = CALCULATE(sum(TProg_Reprog[MtoProg]), ISBLANK(TProg_Reprog[MtoReprog]))
			
			var vDenom =  vReprog + vProg
			                  
			return vDenom
			```
		lineageTag: 7c95301f-3083-469f-9d12-de805eae40e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SPI-OBRA =
			
			VAR vNum = [SPI-Numerador-Obra]
			VAR vDen = [SPI-Denominador-OBRA]
			VAR vRes  = IF(ISBLANK(vDen),0,vDen)
			VAR SPI = IF(vRes=0, 0, IFERROR(vNum / vRes,0))
			RETURN IF(ISBLANK(SPI),0, SPI)
		lineageTag: 7da43639-0d39-4050-860e-3c5a135123c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SPI-Numerador-Obra = ```
			
			var vCostoRealBruto =calculate( sum(bibd_cont_etapa_control[CtlDetMontoBruto]), bibd_cont_etapa_control[GrupoPlan] = "Valorización", 
			                                 FILTER(bibd_cont_etapa_control, bibd_cont_etapa_control[CtlTipoPlan] = "2. EJECUCIÓN REAL" ),                                                       
			                                 bibd_contrato[GrupoMGAvanceFisico]="GrupoAF" , bibd_trimestre[Grupo]<>"Posterior")
			RETURN vCostoRealBruto
			```
