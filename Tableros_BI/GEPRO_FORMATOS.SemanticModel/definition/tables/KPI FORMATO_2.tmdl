	measure CostoRealNeto(AC) =
			
			VAR R1 = CALCULATE(sum(bibd_cont_etapa_control[CtlDetMontoNeto]), bibd_cont_etapa_control[GrupoConcepto2]="Real", bibd_cont_etapa_control[CtlTipoPlan]="2. EJECUCIÓN REAL", bibd_trimestre[Grupo]<>"Posterior")
