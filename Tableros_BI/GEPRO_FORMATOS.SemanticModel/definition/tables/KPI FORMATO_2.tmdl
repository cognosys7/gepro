	measure 'Acum(AC) Corte' =
			
			var vCostoReal  = CALCULATE(sum(bibd_cont_etapa_control[CtlDetMontoBruto]), bibd_cont_etapa_control[GrupoConcepto]="3. Real",  bibd_contrato[GrupoMGAvanceFisico]="GrupoAF" , bibd_trimestre[Grupo]<>"Posterior")*1.18
			var vCostoReal2 = CALCULATE([.Valorización], bibd_contrato[GrupoMGAvanceFisico]="GrupoAF" , bibd_trimestre[Grupo]<>"Posterior")*1.18
			
			var R2 = CALCULATE(
				[.Valorización],
				FILTER(
					ALLSELECTED('bibd_cont_etapa_control'[Año-Mes-Valorizacion]),
					ISONORAFTER('bibd_cont_etapa_control'[Año-Mes-Valorizacion], MAX('bibd_cont_etapa_control'[Año-Mes-Valorizacion]), DESC)
