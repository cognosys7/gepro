	measure FechaInicioAmpliacionCont = CALCULATE(MAX(bibd_cont_ampliacion[AmpFecInicio]), bibd_cont_ampliacion[AmpTipoPlazo]="2. PLAZO CONTRACTUAL", bibd_contrato[GrupoModalidadGestion]="PRINCIPAL" )
