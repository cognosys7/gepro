	measure '% AvaFisicoAcumPV ini' =
			
			CALCULATE(
				[% AvaFisico(PV ini)],
				FILTER(
					ALLSELECTED('bibd_cont_etapa_control'[Año-Mes-Valorizacion]),
					ISONORAFTER('bibd_cont_etapa_control'[Año-Mes-Valorizacion], MAX('bibd_cont_etapa_control'[Año-Mes-Valorizacion]), DESC)
				)
			)
