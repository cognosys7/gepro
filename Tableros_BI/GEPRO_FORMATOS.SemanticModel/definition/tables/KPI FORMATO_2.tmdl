	measure CostoContModificaciones = CALCULATE(sum(bibd_contrato[ContMontoFin]),bibd_contrato[GrupoModalidadGestion]="MODIFICACIONES")+[CostoLineaBaseNeto(PV ini)]
		formatString: #,0.00
