	measure '% AvaFisico(EV rep)' = ```
			
			
			VAR vCostoRealCorte         = [Acum(AC) Corte]
			VAR vCostoContratoAprobados = [CostoContAprobado]
			VAR vDen = if(ISBLANK(vCostoContratoAprobados),0,vCostoContratoAprobados)
			VAR R1 = if(vDen=0,0,IFERROR(vCostoRealCorte / vCostoContratoAprobados,0))
			
			return IF(ISBLANK(R1),0,R1)
			
			
