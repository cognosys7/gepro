		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SPI-Reprogramacion-OBRA = ```
			
			var AnioMesEje = [AnioMesEjecucion]
			var vReprog =  CALCULATE( sum(bibd_cont_etapa_control[CtlDetMontoBruto]),   
			                                   filter(bibd_cont_etapa_control, bibd_cont_etapa_control[ContratoConceptoPlan] = RELATED(TReprogMax[RepMAx])) ,                                        
			                                   bibd_cont_etapa_control[CtlTipoPlan]="3. REPROGRAMACION", bibd_contrato[GrupoMGAvanceFisico]="GrupoAF"  )
			
			var vProg =   CALCULATE( sum(bibd_cont_etapa_control[CtlDetMontoBruto]),  
			                                   FILTER(bibd_cont_etapa_control, bibd_cont_etapa_control[CtlTipoPlan] = "1. LÍNEA BASE"), bibd_contrato[GrupoMGAvanceFisico]="GrupoAF",  ISBLANK(TProg_Reprog[MtoReprog]) )
			                     
			
			--var vProg2   = CALCULATE(sum(TProg_Reprog[MtoProg]), ISBLANK(TProg_Reprog[MtoReprog]))
			--var vRep     =  if(ISBLANK(vReprog), vProg2, vReprog)
			var vRep    = vReprog + vProg
			               
			return vRep
