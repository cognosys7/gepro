	measure FechaTerminoVigente =
			
			var r1 = MAXX( KEEPFILTERS(VALUES('bibd_cont_ampliacion'[AmpFecTermino])), 	CALCULATE(MAX('bibd_cont_ampliacion'[AmpFecTermino])) )
			var r2 = CALCULATE(max(bibd_cont_ampliacion[AmpFecTermino]), FILTER(bibd_cont_ampliacion, bibd_cont_ampliacion[NumOrden]= max(bibd_cont_ampliacion[NumOrden])) )
			return r2
		formatString: Short Date
		lineageTag: 0a0e59f2-2385-47d3-b60d-e4e8a061b4c9

	measure PlazoLineaBase =
			
			VAR R1 = CALCULATE(SUM(bibd_cont_ampliacion[AmpCantDiasCalendario]), bibd_cont_ampliacion[AmpTipoPlazo]="2. PLAZO CONTRACTUAL", bibd_contrato[GrupoModalidadGestion]="PRINCIPAL" )
			VAR R2 = IF(ISBLANK(R1),0,R1)
			RETURN R2
		formatString: 0
		lineageTag: 6a7a8e52-7070-48ac-b0ed-9b5f9e8f1b5a

