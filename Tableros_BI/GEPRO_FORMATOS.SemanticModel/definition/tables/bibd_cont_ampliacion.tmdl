	column GrupoTipoPlazp =
			SWITCH(
			  TRUE,
			  ISBLANK('bibd_cont_ampliacion'[AmpTipoPlazo]),
			  "(En blanco)",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"4. AMPLIACIÓN DE PLAZO"},
			  "Ampliación de Plazo",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"7. AMPLIACIÓN EXCEPCIONAL DE PLAZO"},
			  "Ampliación Excepcional de Plazo",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"1. ENTREGA DE TERRENO"},
			  "Entrega de Terreno",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"2. PLAZO CONTRACTUAL"},
			  "Plazo Contractual",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"6. REDUCCION DE PLAZO"},
			  "Reducción de Plazo",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"1. REUNIÓN DE ARRANQUE"},
			  "Reunión de Arranque",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"5. SUSPENSIÓN DE PLAZO"},
			  "Suspensión de Plazo de Ejecución",
			  'bibd_cont_ampliacion'[AmpTipoPlazo]
			)
		lineageTag: 67dbf1d7-e43a-48f0-81f9-4ce8094d8df0
		summarizeBy: none

