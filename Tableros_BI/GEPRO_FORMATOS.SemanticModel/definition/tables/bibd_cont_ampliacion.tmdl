	column GrupoTipoCalendario =
			SWITCH(
			  TRUE,
			  ISBLANK('bibd_cont_ampliacion'[AmpTipoPlazo]),
			  "(En blanco)",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"9.LIQUIDACIÓN"},
			  "LIQUIDACIÓN",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"2. PLAZO CONTRACTUAL"},
			  "PROGRAMADO",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"8. RECEPCIÓN"},
			  "RECEPCIÓN",
			  'bibd_cont_ampliacion'[AmpTipoPlazo] IN {"4. AMPLIACIÓN DE PLAZO",
			    "5. SUSPENSIÓN DE PLAZO",
			    "6. REDUCCION DE PLAZO",
			    "7. AMPLIACIÓN EXCEPCIONAL DE PLAZO"},
