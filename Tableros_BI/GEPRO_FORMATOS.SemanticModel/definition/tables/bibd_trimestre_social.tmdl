	column GrupoTrimestre =
			SWITCH(
			  TRUE,
			  ISBLANK('bibd_trimestre_social'[MatchTrim]),
			  "(En blanco)",
			  'bibd_trimestre_social'[MatchTrim] IN {"1"},
			  "Actual",
			  'bibd_trimestre_social'[MatchTrim] IN {"3"},
			  "Anterior",
			  'bibd_trimestre_social'[MatchTrim] IN {"2"},
