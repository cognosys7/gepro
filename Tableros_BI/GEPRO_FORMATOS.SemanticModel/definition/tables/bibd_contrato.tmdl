			  "2. Contrato Complementario",
			  'bibd_contrato'[ContModalidadGestion] IN {"CONTRATACIONES VINCULADAS"},
			  "3. Contrataciones Vinculantes",
			  'bibd_contrato'[ContModalidadGestion] IN {"CONTRATACION VINCULADA COMPLEMENTARIA"},
			  "4. Contratación Vinculada Complementaria",
			  "Otros"
			)
