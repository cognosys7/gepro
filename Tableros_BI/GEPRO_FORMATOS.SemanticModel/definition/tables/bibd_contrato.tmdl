	column GrupoValorizaModalidad =
			SWITCH(
			  TRUE,
			  ISBLANK('bibd_contrato'[ContModalidadGestion]),
			  "(En blanco)",
			  'bibd_contrato'[ContModalidadGestion] IN {"CONTRATO PRINCIPAL"},
			  "1. Contrato Principal (CP)",
			  'bibd_contrato'[ContModalidadGestion] IN {"ADICIONAL 01",
